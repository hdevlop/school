{
  "name": "sms-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/dashboard dev",
    "dev:https": "bun run --cwd apps/dashboard https",
    "start": "bun run --cwd apps/dashboard start",
    "build": "bun run --cwd apps/dashboard build",
    "build:all": "bun run build",
    "typecheck": "bun run --cwd packages/contracts typecheck && bun run --cwd packages/server typecheck && bun run --cwd packages/server typecheck:test && bun run --cwd packages/seed typecheck && bun run --cwd apps/dashboard typecheck",
    "test:config": "bun test packages/contracts/tests apps/dashboard/src/features apps/dashboard/src/lib apps/dashboard/src/services apps/dashboard/src/shared",
    "test:server-i18n": "bun test packages/server/tests/i18n",
    "test:boundaries": "bun test scripts/tests && node scripts/check-workspace-boundaries.mjs",
    "test": "bun run test:config && bun run test:server-i18n && bun run test:access-reset && bun run test:routines && bun run test:academic-years && bun run test:teacher-dashboard && bun run test:ownership && bun run test:security && bun run test:boundaries",
    "check": "bun run lint && bun run typecheck && bun run i18n:check && bun run test && bun run build && bun run db:check",
    "lint": "eslint apps/dashboard/src packages/contracts/src packages/contracts/tests packages/server/src packages/server/tests packages/seed/src scripts",
    "test:access-reset": "bun test packages/server/tests/accessReset/AccessResetService.test.ts packages/server/tests/accessReset/AccessResetValidator.test.ts apps/dashboard/src/features/Users/config/accessResetModes.test.ts",
    "test:routines": "bun test packages/server/tests/classRoutines/ClassRoutineDto.test.ts packages/server/tests/classRoutines/ClassRoutineService.test.ts packages/server/tests/classRoutines/SeedResetOrder.test.ts",
    "test:academic-years": "bun test packages/contracts/tests/academicYears.test.ts packages/server/tests/academicYears",
    "test:history:base:db": "bun test packages/server/tests/acceptance/HistoryBaseDatabase.test.ts",
    "test:history:alerts:db": "bun test packages/server/tests/acceptance/AlertsHistoryDatabase.test.ts",
    "test:history:alerts:transport": "bun test packages/server/tests/acceptance/AlertsHistoryTransport.test.ts",
    "test:history:announcements:db": "bun test packages/server/tests/acceptance/AnnouncementsHistoryDatabase.test.ts",
    "test:history:announcements:transport": "bun test packages/server/tests/acceptance/AnnouncementsHistoryTransport.test.ts",
    "test:history:behavior-rewards:db": "bun test packages/server/tests/acceptance/BehaviorRewardsHistoryDatabase.test.ts",
    "test:history:behavior-rewards:transport": "bun test packages/server/tests/acceptance/BehaviorRewardsHistoryTransport.test.ts",
    "test:history:discipline:db": "bun test packages/server/tests/acceptance/DisciplineOwnershipDatabase.test.ts packages/server/tests/acceptance/DisciplineHistoryDatabase.test.ts",
    "test:history:discipline:transport": "bun test packages/server/tests/acceptance/DisciplineHistoryTransport.test.ts",
    "test:history:exams:db": "bun test packages/server/tests/acceptance/ExamsHistoryDatabase.test.ts",
    "test:history:exams:transport": "bun test packages/server/tests/acceptance/ExamsHistoryTransport.test.ts",
    "test:history:grades:db": "bun test packages/server/tests/acceptance/GradesHistoryDatabase.test.ts",
    "test:history:grades:transport": "bun test packages/server/tests/acceptance/GradesHistoryTransport.test.ts",
    "test:history:notifications:transport": "bun test packages/server/tests/acceptance/NotificationsHistoryTransport.test.ts",
    "test:history:events:db": "bun test packages/server/tests/acceptance/EventsHistoryDatabase.test.ts",
    "test:history:events:transport": "bun test packages/server/tests/acceptance/EventsHistoryTransport.test.ts",
    "test:history:classes:db": "bun test packages/server/tests/acceptance/ClassesHistoryDatabase.test.ts",
    "test:history:classes:transport": "bun test packages/server/tests/acceptance/ClassesHistoryTransport.test.ts",
    "test:history:catalogs:transport": "bun test packages/server/tests/acceptance/CatalogsHistoryTransport.test.ts",
    "test:history:dashboard:db": "bun test packages/server/tests/acceptance/DashboardHistoryDatabase.test.ts",
    "test:history:dashboard:transport": "bun test packages/server/tests/acceptance/DashboardHistoryTransport.test.ts",
    "test:history:parents:db": "bun test packages/server/tests/acceptance/ParentsHistoryDatabase.test.ts",
    "test:history:parents:transport": "bun test packages/server/tests/acceptance/ParentsHistoryTransport.test.ts",
    "test:history:enrollments:db": "bun test packages/server/tests/acceptance/EnrollmentsHistoryDatabase.test.ts",
    "test:history:enrollments:transport": "bun test packages/server/tests/acceptance/EnrollmentsHistoryTransport.test.ts",
    "test:history:students:db": "bun test packages/server/tests/acceptance/StudentsHistoryDatabase.test.ts",
    "test:history:students:transport": "bun test packages/server/tests/acceptance/StudentsHistoryTransport.test.ts",
    "test:history:profiles:db": "bun test packages/server/tests/acceptance/ProfilesHistoryDatabase.test.ts",
    "test:history:profiles:transport": "bun test packages/server/tests/acceptance/ProfilesHistoryTransport.test.ts",
    "test:history:settings:db": "bun test packages/server/tests/acceptance/SettingsHistoryDatabase.test.ts",
    "test:history:settings:transport": "bun test packages/server/tests/acceptance/SettingsHistoryTransport.test.ts",
    "test:history:staff:db": "bun test packages/server/tests/acceptance/StaffHistoryDatabase.test.ts",
    "test:history:staff:transport": "bun test packages/server/tests/acceptance/StaffHistoryTransport.test.ts",
    "test:history:teachers:db": "bun test packages/server/tests/acceptance/TeachersHistoryDatabase.test.ts",
    "test:history:teachers:transport": "bun test packages/server/tests/acceptance/TeachersHistoryTransport.test.ts",
    "test:teacher-dashboard": "bun test packages/server/tests/teacherDashboard",
    "test:ownership": "bun test packages/server/tests/ownership",
    "test:security": "bun test packages/server/tests/security",
    "test:security:transport": "bun test packages/server/tests/acceptance/RouteSecurityTransport.test.ts && bun test packages/server/tests/acceptance/ConcurrentRefreshTransport.test.ts",
    "db:generate": "bun --env-file=apps/dashboard/.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=apps/dashboard/.env.local drizzle-kit migrate",
    "db:push": "bun --env-file=apps/dashboard/.env.local drizzle-kit push",
    "db:push:force": "bun --env-file=apps/dashboard/.env.local drizzle-kit push --force",
    "db:drop": "bun --env-file=apps/dashboard/.env.local drizzle-kit drop",
    "db:check": "bun --env-file=apps/dashboard/.env.local drizzle-kit check",
    "academic-years:audit": "bun --env-file=apps/dashboard/.env.local packages/server/src/scripts/academicYearAudit.ts",
    "academic-years:enrollment-issues": "bun --env-file=apps/dashboard/.env.local packages/server/src/scripts/academicYearEnrollmentIssues.ts",
    "academic-years:attendance-backfill": "bun --env-file=apps/dashboard/.env.local packages/server/src/scripts/academicYearAttendanceBackfill.ts",
    "academic-years:source-backfill": "bun --env-file=apps/dashboard/.env.local packages/server/src/scripts/academicYearSourceBackfill.ts",
    "academic-years:grade-backfill": "bun --env-file=apps/dashboard/.env.local packages/server/src/scripts/academicYearGradeBackfill.ts",
    "notifications:worker": "bun --cwd packages/server --env-file=../../apps/dashboard/.env.local src/workers/notificationsWorker.ts",
    "notifications:dispatch": "bun --cwd packages/server --env-file=../../apps/dashboard/.env.local src/workers/notificationsDispatch.ts",
    "seed:admin": "bun run --cwd packages/seed seed:admin",
    "seed:roles": "bun run --cwd packages/seed seed:roles",
    "seed:staff": "bun run --cwd packages/seed seed:staff",
    "seed:school": "bun run --cwd packages/seed seed:school",
    "seed:history:base": "bun packages/server/tests/academicYears/fixtures/seedAlertsHistory.ts",
    "seed:history:alerts": "bun packages/server/tests/academicYears/fixtures/seedAlertsHistoryCases.ts",
    "seed:history:announcements": "bun packages/server/tests/academicYears/fixtures/seedAnnouncementsHistoryCases.ts",
    "seed:history:academic-records": "bun packages/server/tests/academicYears/fixtures/seedAcademicRecordHistoryCases.ts",
    "seed:demo": "bun run --cwd packages/seed seed:demo",
    "seed:demo:history": "bun run --cwd packages/seed seed:history",
    "seed:expenses": "bun run --cwd packages/seed seed:expenses",
    "seed:topup": "bun run --cwd packages/seed seed:topup",
    "gen:demo": "bun run --cwd packages/seed gen:demo",
    "reset:demo": "bun run --cwd packages/seed reset:demo",
    "seed:full": "bun run --cwd packages/seed seed:full",
    "seed": "bun run --cwd packages/seed seed",
    "gen:demo:ui": "bun run --cwd packages/seed gen:demo:ui",
    "validate": "bun datasets/validate-dataset.ts",
    "validate:quiet": "bun datasets/validate-dataset.ts --quiet",
    "validate:tools": "bun datasets/validate-dataset.ts --list-tools",
    "i18n:check": "python scripts/check_i18n_keys.py",
    "gen": "bun datasets/gen-dataset.ts",
    "gen:all": "bun datasets/gen-dataset.ts --all",
    "gen:list": "bun datasets/gen-dataset.ts --list",
    "gen:prompts": "bun datasets/gen-dataset.ts --all"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.0",
    "eslint-config-next": "16.2.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@types/node": "^25.6.0",
    "ioredis": "5.11.1",
    "najm-api": "3.1.0",
    "najm-auth": "4.2.4",
    "najm-cache": "2.2.0",
    "najm-chatbot": "2.0.5",
    "najm-cookies": "2.0.2",
    "najm-core": "3.0.2",
    "najm-cors": "2.0.2",
    "najm-database": "2.1.1",
    "najm-email": "2.0.4",
    "najm-event": "2.0.2",
    "najm-guard": "2.2.0",
    "najm-i18n": "2.1.2",
    "najm-kit": "2.16.15",
    "najm-mcp": "2.2.2",
    "najm-next": "0.8.0",
    "najm-rag": "2.1.2",
    "najm-rate": "2.1.1",
    "najm-storage": "3.0.0",
    "najm-theme": "0.2.2",
    "najm-validation": "2.0.2",
    "sqlite-vec": "^0.1.9",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "@babel/core": "7.29.7",
    "@radix-ui/react-direction": "1.1.2",
    "axios": "1.20.0",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.9",
    "esbuild": "0.25.12",
    "fast-uri": "3.1.7",
    "form-data": "4.0.6",
    "hono": "4.12.34",
    "ip-address": "10.7.0",
    "ioredis": "5.11.1",
    "joi": "18.2.1",
    "nanoid": "5.1.16",
    "nodemailer": "9.1.1",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "sharp": "0.35.3",
    "najm-auth": "$najm-auth",
    "najm-core": "$najm-core",
    "diject": "0.1.11",
    "drizzle-orm": "0.45.2",
    "najm-api": "$najm-api",
    "najm-cache": "$najm-cache",
    "najm-chatbot": "$najm-chatbot",
    "najm-cookies": "$najm-cookies",
    "najm-cors": "$najm-cors",
    "najm-database": "$najm-database",
    "najm-email": "$najm-email",
    "najm-event": "$najm-event",
    "najm-guard": "$najm-guard",
    "najm-i18n": "$najm-i18n",
    "najm-kit": "$najm-kit",
    "najm-mcp": "$najm-mcp",
    "najm-next": "$najm-next",
    "najm-rag": "$najm-rag",
    "najm-rate": "$najm-rate",
    "najm-storage": "$najm-storage",
    "najm-theme": "$najm-theme",
    "najm-validation": "$najm-validation"
  },
  "trustedDependencies": [
    "protobufjs",
    "unrs-resolver"
  ]
}
