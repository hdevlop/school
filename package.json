{
  "name": "sms-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/dashboard dev",
    "start": "bun run --cwd apps/dashboard start",
    "build": "cd apps/dashboard && bun run build",
    "build:server": "bun run --cwd packages/server build",
    "build:seed": "bun run --cwd packages/seed build",
    "build:all": "bun run build:server && bun run build:seed && bun run build",
    "lint": "bun run --filter @sms/dashboard lint",
    "test:seed": "bun test packages/seed/src/fakers",
    "test:server": "bun test packages/server/tests",
    "test:dashboard": "bun test apps/dashboard/src",
    "test:e2e:najm-upgrade": "bun run --cwd apps/dashboard test:e2e:najm-upgrade",
    "test:e2e:acceptance": "bun run --cwd apps/dashboard test:e2e:acceptance",
    "db:generate": "bun --env-file=apps/dashboard/.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=apps/dashboard/.env.local drizzle-kit migrate",
    "db:push": "bun --env-file=apps/dashboard/.env.local drizzle-kit push",
    "db:push:force": "bun --env-file=apps/dashboard/.env.local drizzle-kit push --force",
    "db:drop": "bun --env-file=apps/dashboard/.env.local drizzle-kit drop",
    "db:check": "bun --env-file=apps/dashboard/.env.local drizzle-kit check",
    "notifications:worker": "bun --cwd packages/server --env-file=../../apps/dashboard/.env.local src/workers/notificationsWorker.ts",
    "notifications:dispatch": "bun --cwd packages/server --env-file=../../apps/dashboard/.env.local src/workers/notificationsDispatch.ts",
    "seed:admin": "bun run --cwd packages/seed seed:admin",
    "seed:roles": "bun run --cwd packages/seed seed:roles",
    "seed:staff": "bun run --cwd packages/seed seed:staff",
    "seed:school": "bun run --cwd packages/seed seed:school",
    "seed:demo": "bun run --cwd packages/seed seed:demo",
    "seed:expenses": "bun run --cwd packages/seed seed:expenses",
    "seed:topup": "bun run --cwd packages/seed seed:topup",
    "gen:demo": "bun run --cwd packages/seed gen:demo",
    "reset:demo": "bun run --cwd packages/seed reset:demo",
    "seed:full": "bun run --cwd packages/seed seed:full",
    "seed": "bun run --cwd packages/seed gen:demo:ui",
    "validate": "bun datasets/validate-dataset.ts",
    "validate:quiet": "bun datasets/validate-dataset.ts --quiet",
    "validate:tools": "bun datasets/validate-dataset.ts --list-tools",
    "i18n:check": "python scripts/check_i18n_keys.py",
    "gen": "bun datasets/gen-dataset.ts",
    "gen:all": "bun datasets/gen-dataset.ts --all",
    "gen:list": "bun datasets/gen-dataset.ts --list",
    "gen:prompts": "bun datasets/gen-dataset.ts --all"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "drizzle-kit": "^0.31.10",
    "tsup": "8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@types/node": "^25.6.0",
    "ioredis": "5.11.1",
    "najm-api": "2.0.5",
    "najm-auth": "4.0.4",
    "najm-cache": "2.2.0",
    "najm-chatbot": "2.0.3",
    "najm-cookies": "2.0.2",
    "najm-core": "2.0.6",
    "najm-cors": "2.0.2",
    "najm-database": "2.0.4",
    "najm-email": "2.0.4",
    "najm-event": "2.0.2",
    "najm-guard": "2.0.2",
    "najm-i18n": "2.1.2",
    "najm-kit": "2.15.2",
    "najm-mcp": "2.1.2",
    "najm-next": "0.7.0",
    "najm-rag": "2.0.3",
    "najm-rate": "2.1.1",
    "najm-storage": "2.2.0",
    "najm-theme": "0.2.1",
    "najm-validation": "2.0.2",
    "sqlite-vec": "^0.1.9",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "@babel/core": "7.29.7",
    "axios": "1.20.0",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.9",
    "esbuild": "0.25.12",
    "fast-uri": "3.1.7",
    "form-data": "4.0.6",
    "hono": "4.12.34",
    "ip-address": "10.7.0",
    "ioredis": "5.11.1",
    "joi": "18.2.1",
    "nanoid": "5.1.16",
    "nodemailer": "9.1.1",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "sharp": "0.35.3",
    "najm-auth": "$najm-auth",
    "najm-core": "$najm-core",
    "diject": "0.1.8",
    "drizzle-orm": "0.45.2",
    "najm-api": "$najm-api",
    "najm-cache": "$najm-cache",
    "najm-chatbot": "$najm-chatbot",
    "najm-cookies": "$najm-cookies",
    "najm-cors": "$najm-cors",
    "najm-database": "$najm-database",
    "najm-email": "$najm-email",
    "najm-event": "$najm-event",
    "najm-guard": "$najm-guard",
    "najm-i18n": "$najm-i18n",
    "najm-kit": "$najm-kit",
    "najm-mcp": "$najm-mcp",
    "najm-next": "$najm-next",
    "najm-rag": "$najm-rag",
    "najm-rate": "$najm-rate",
    "najm-storage": "$najm-storage",
    "najm-theme": "$najm-theme",
    "najm-validation": "$najm-validation"
  },
  "trustedDependencies": [
    "protobufjs",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "najm-auth@4.0.4": "patches/najm-auth@4.0.4.patch"
  }
}
