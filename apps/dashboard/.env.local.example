# School Management System — environment template
#
# Copy to `apps/dashboard/.env.local` and fill in real values:
#
#   cp apps/dashboard/.env.local.example apps/dashboard/.env.local
#
# This one file is the whole monorepo's environment. Next.js loads it for the
# dashboard, and every root `db:*` and `seed:*` script passes it explicitly with
# `--env-file=apps/dashboard/.env.local`. There is no root `.env`.
#
# Never commit `.env.local`. Only this template is tracked.
#
# Values marked REQUIRED abort startup when missing. The rest have documented
# defaults that are fine for local development and wrong for production.

# ---------------------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------------------
# Read by packages/server/src/database/db.ts and drizzle.config.ts. `DB_URL` is
# the name the Drizzle config requires; `DATABASE_URL` is only a fallback for
# the runtime client, so set `DB_URL` or migrations will fail.
DB_URL=postgres://postgres:postgres@localhost:5432/school

# ---------------------------------------------------------------------------
# Najm Auth v3 — REQUIRED
# ---------------------------------------------------------------------------
# najm-auth@3.3.0 reads these itself; School's authConfig() never passes them.
# A missing JWT secret throws `Plugin "auth" requires configuration: <NAME>` at
# startup, which surfaces during `bun run build` as a page-data collection
# failure, not as a runtime error. Use long random values, different per
# environment, and never reuse the access secret as the refresh secret.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# 32 bytes, base64 or hex. Missing throws "Encryption key missing".
# Generate with: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())"
# Rotating this invalidates every value encrypted with the previous key.
NAJM_ENCRYPTION_KEY=replace-with-32-random-bytes-base64-or-hex

# ---------------------------------------------------------------------------
# Najm Auth v3 — optional, with defaults
# ---------------------------------------------------------------------------
# Signs the short-lived session cookie the React server session adapter reads
# (apps/dashboard/src/lib/session.ts). najm-auth falls back to
# JWT_ACCESS_SECRET when this is unset, so leaving it blank works — setting it
# separately means a rotated session secret does not invalidate access tokens.
# NAJM_SESSION_SECRET=

# Absolute origin the server uses to reach its own auth API when recovering an
# expired signed session during a server render. Unset means no server-side
# recovery: the render falls back to unauthenticated and the browser recovers
# on its next request. Set this wherever the server cannot reach itself at the
# public URL (containers, internal load balancers).
# NAJM_AUTH_INTERNAL_URL=http://127.0.0.1:3000/api/auth/session/recover

# Local direct access trusts no forwarded address. Production uses 1 for the
# current direct Dokploy proxy topology.
# SCHOOL_TRUSTED_PROXY_HOPS=0

# Local development uses a process-local cache when this is absent. Set a
# redis:// or rediss:// URL to exercise Redis locally. Production requires an
# authenticated URL and refuses to start if Redis is missing or unreachable.
# REDIS_URL=redis://:local-password@127.0.0.1:6379/0

# Not used by School: apps/dashboard/src/lib/auth.ts sets `apiBaseURL: '/api'`
# explicitly, so najm-auth never consults NAJM_AUTH_BASE_URL. Listed so nobody
# sets it expecting an effect.

# Used for auth email links and the OAuth callback default. Defaults to
# http://localhost:3000.
# FRONTEND_URL=http://localhost:3000

# Token lifetimes. Defaults: 1h and 7d.
# ACCESS_EXPIRES_IN=1h
# REFRESH_EXPIRES_IN=7d

# Google OAuth is not enabled in School's authConfig(). These are read only if
# it is turned on later.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=

# ---------------------------------------------------------------------------
# App URLs and CORS
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Overrides NEXT_PUBLIC_APP_URL as the allowed CORS origin when they differ.
# CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Supported providers: console, memory, resend, sendgrid, smtp. Unset means
# console. `console` prints messages to the server log instead of sending them,
# which is what local development should use; `memory` keeps them in process
# for tests. Najm Auth's invitation and credential setup flows both go through
# this transport, and get the same resolved configuration as the email plugin.
EMAIL_PROVIDER=console
EMAIL_DEFAULT_FROM=noreply@sms.local
# EMAIL_DEFAULT_REPLY_TO=
# Boolean flags below accept `1` or `true`; anything else is off.
# EMAIL_DEBUG=false
# Retries around a failed send. Defaults: 1 attempt, 1000 ms apart.
# EMAIL_RETRY_ATTEMPTS=1
# EMAIL_RETRY_DELAY=1000

# console only — `info` (default) or `debug`.
# EMAIL_LOG_LEVEL=info

# resend — required when EMAIL_PROVIDER=resend.
# RESEND_API_KEY=

# sendgrid — API key required; sandbox mode accepts the send without
# delivering it.
# SENDGRID_API_KEY=
# SENDGRID_SANDBOX_MODE=false

# smtp — host required, port defaults to 587. SMTP_USER and SMTP_PASS must be
# set together or left out together; omit both for an unauthenticated relay.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---------------------------------------------------------------------------
# Seeding and provisioning
# ---------------------------------------------------------------------------
# `bun run seed:admin` creates or resets the administrator with these values.
# Outside production, an unset or untouched ADMIN_PASSWORD falls back to the
# admin@admin.com / School2026 local defaults.
# Production requires an explicit email and a unique non-template password.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=replace-before-any-shared-environment

# Password given to accounts created by seed and import workflows, which skip
# the email invitation. Defaults to ChangeMe123.
# DEFAULT_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Feature switches
# ---------------------------------------------------------------------------
# F8 form auto-fill. Off in production unless this is explicitly `true`; on in
# development unless explicitly `false`.
# NEXT_PUBLIC_FORM_FILL_ENABLED=false

# Personal notification inbox and web push. Generate one stable VAPID pair
# with `bunx web-push generate-vapid-keys`; never commit the private key.
NOTIFICATIONS_DISPATCH_ENABLED=false
NOTIFICATIONS_PUSH_ENABLED=false
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=mailto:ops@example.com

# Pins "today" for date-dependent domain logic. Format: YYYY-MM-DD. Leave unset
# outside tests and demos.
# APP_BUSINESS_DATE=

# Google Maps location picker. This is a public browser key: restrict it by
# referrer and API in Google Cloud. The runtime variable works after a server
# restart without rebuilding the dashboard; the old NEXT_PUBLIC name remains a
# temporary compatibility fallback.
# SCHOOL_LOCATION_MAP_PROVIDER=google
# SCHOOL_LOCATION_GOOGLE_API_KEY=
# SCHOOL_LOCATION_GOOGLE_MAP_ID=
# SCHOOL_LOCATION_GOOGLE_LANGUAGE=
# SCHOOL_LOCATION_GOOGLE_REGION=MA
# SCHOOL_LOCATION_DEFAULT_LATITUDE=33.5731
# SCHOOL_LOCATION_DEFAULT_LONGITUDE=-7.5898
# SCHOOL_LOCATION_DEFAULT_ZOOM=12
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Dev server and build directory (najm-next)
# ---------------------------------------------------------------------------
# Extra origins allowed to request the dev server, comma separated. Empty by
# default, so nothing else on the LAN reaches HMR or dev source payloads.
# Needed for phone testing through `bun run --cwd apps/dashboard https`.
# NAJM_NEXT_DEV_ORIGINS=127.0.0.1,192.168.1.13

# Alternate Next.js build directory, for a parallel build such as an E2E run.
# Defaults to .next
# NAJM_NEXT_DIST_DIR=

# Enable admin-only in-process benchmark cache resets on an isolated dev app.
# Always disabled in production; does not unload the embedding model or clear cooldown.
# CHATBOT_BENCHMARK_CONTROLS=false

# ---------------------------------------------------------------------------
# RAG embeddings (optional — defaults target a local Ollama)
# ---------------------------------------------------------------------------
# RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# RAG_EMBEDDING_PROVIDER=ollama
# RAG_EMBEDDING_MODEL=embeddinggemma
# RAG_EMBEDDING_DIMENSIONS=768
# Indexing requests; chat questions use the query timeout below.
# RAG_EMBEDDING_TIMEOUT_MS=60000
# RAG_EMBEDDING_QUERY_TIMEOUT_MS=5000
# After a failed question embedding, skip the provider for this long.
# RAG_EMBEDDING_QUERY_COOLDOWN_MS=30000
# RAG_EMBEDDING_BATCH_SIZE=4
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_TRUNCATE_DIMENSIONS=false
# For local llama.cpp, set RAG_EMBEDDING_PROVIDER=openai-compatible and use
# RAG_EMBEDDING_BASE_URL=http://127.0.0.1:18080/v1. School then defaults to
# EmbeddingGemma's query/document prefixes; override only if the model needs it.
# RAG_EMBEDDING_QUERY_PREFIX="task: search result | query: "
# RAG_EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
# Qwen3 Embedding 0.6B (llama.cpp port 18081) returns 1024 values; it supports
# Matryoshka shortening to the schema's 768 dimensions. Use model alias
# qwen3-embedding, RAG_EMBEDDING_TRUNCATE_DIMENSIONS=true, and port 18081.
# School supplies its query instruction and leaves documentPrefix empty.
# Ollama can serve the same Q8_0 model instead of llama.cpp: run
# `ollama pull qwen3-embedding:0.6b` and `ollama cp qwen3-embedding:0.6b qwen3-embedding`,
# then use openai-compatible with RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1.
# Reindex tools after any model change; fingerprints do not include the model.
