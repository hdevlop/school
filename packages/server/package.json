{
  "name": "@sms/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./najm": {
      "types": "./src/najm.ts",
      "default": "./src/najm.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./src/auth.ts"
    },
    "./database": {
      "types": "./src/database/db.ts",
      "default": "./src/database/db.ts"
    },
    "./database/schema": {
      "types": "./src/database/schema/index.ts",
      "default": "./src/database/schema/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    },
    "./modules": {
      "types": "./src/modules/index.ts",
      "default": "./src/modules/index.ts"
    },
    "./modules/seed": {
      "types": "./src/modules/seed/SeedContainer.ts",
      "default": "./src/modules/seed/SeedContainer.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@sms/contracts": "workspace:*",
    "diject": "0.1.11",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.12",
    "ioredis": "5.11.1",
    "lodash.isempty": "^4.4.0",
    "najm-auth": "6.0.0",
    "najm-cache": "2.2.0",
    "najm-core": "3.0.4",
    "najm-cors": "2.0.3",
    "najm-chatbot": "3.3.0",
    "najm-database": "2.2.1",
    "najm-event": "2.0.2",
    "najm-guard": "2.2.1",
    "najm-i18n": "2.1.3",
    "najm-mcp": "2.2.5",
    "najm-rag": "3.2.0",
    "najm-rate": "3.0.0",
    "najm-storage": "4.0.0",
    "najm-theme": "0.3.0",
    "najm-validation": "2.0.3",
    "nanoid": "^5.0.0",
    "nodemailer": "10.0.14",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "postgres": "3.4.8",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4"
  }
}
