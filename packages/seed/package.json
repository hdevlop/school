{
  "name": "@sms/seed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "seed": "bun --env-file=../../apps/dashboard/.env.local src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:admin":    "bun --env-file=../../apps/dashboard/.env.local src/scripts/admin/seed-admin.ts",
    "seed:staff":    "bun --env-file=../../apps/dashboard/.env.local src/scripts/admin/seed-staff-backfill.ts",
    "seed:roles":    "bun --env-file=../../apps/dashboard/.env.local src/scripts/admin/seed-staff-roles.ts",
    "seed:school":   "bun --env-file=../../apps/dashboard/.env.local src/scripts/school/seed-school.ts",
    "seed:demo":     "bun --env-file=../../apps/dashboard/.env.local src/scripts/demo/seed-demo.ts",
    "seed:expenses": "bun --env-file=../../apps/dashboard/.env.local src/scripts/demo/seed-expenses.ts",
    "seed:topup":    "bun --env-file=../../apps/dashboard/.env.local src/scripts/demo/seed-topup.ts",
    "gen:demo":      "bun src/scripts/demo/generator.ts",
    "gen:demo:ui":   "bun src/scripts/demo/cli.ts",
    "reset:demo":    "bun --env-file=../../apps/dashboard/.env.local src/scripts/demo/reset-demo.ts",
    "seed:full":     "bun run seed:admin && bun run gen:demo && bun run reset:demo && bun run seed:demo"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@sms/contracts": "workspace:*",
    "@sms/server": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2",
    "najm-auth": "4.0.8"
  }
}
