# Copy to /opt/school/env/app.env, chmod 0600, and replace every placeholder.
# "postgres" below is the compose service name, resolved over the internal
# backend network — not localhost and not the host's own Postgres, if any.
DB_URL=postgresql://school:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/school_production

NEXT_PUBLIC_APP_URL=https://REPLACE_WITH_DOMAIN
FRONTEND_URL=https://REPLACE_WITH_DOMAIN
# Overrides NEXT_PUBLIC_APP_URL as the allowed CORS origin only if they differ.
# CORS_ORIGIN=

# Loopback is correct here: the app reaches its own auth API through the
# container's own port, not through Dokploy's public routing.
NAJM_AUTH_INTERNAL_URL=http://127.0.0.1:3000/api/auth/session/recover

JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_AT_LEAST_32_DIFFERENT_RANDOM_CHARACTERS
# 32 bytes, base64 or hex. Generate with:
# bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())"
NAJM_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64_OR_HEX

# Exact number of known proxies between clients and the app. The current
# direct Dokploy proxy topology is one hop; review this with any ingress change.
SCHOOL_TRUSTED_PROXY_HOPS=1

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# "console" only prints emails to the container log — replace before real use.
EMAIL_PROVIDER=REPLACE_WITH_NON_CONSOLE_PROVIDER
EMAIL_DEFAULT_FROM=School <no-reply@example.com>
# resend, sendgrid, or smtp for real delivery. Provider-specific values belong
# here too (RESEND_API_KEY, SENDGRID_API_KEY, SMTP_HOST/PORT/SECURE/USER/PASS);
# apps/dashboard/.env.local.example documents every supported variable.

# Off unless explicitly enabled — never turn this on for real users.
NEXT_PUBLIC_FORM_FILL_ENABLED=false
