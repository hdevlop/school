# Copy to /opt/school/env/infrastructure.env, chmod 0600, and replace placeholders.
COMPOSE_PROJECT_NAME=school
SCHOOL_IMAGE=ghcr.io/hdevlop/school:sha-REPLACE_WITH_FULL_40_CHARACTER_GIT_SHA
# Kafil already uses 3300 on this VPS — keep this distinct from that and from
# anything else already bound on the host.
SCHOOL_LOOPBACK_PORT=3400
SCHOOL_STORAGE_HOST_PATH=/srv/school/storage-production

POSTGRES_DB=school_production
POSTGRES_USER=school
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD

# Dokploy owns routing and TLS for this app on this VPS — point Dokploy's own
# domain setting at 127.0.0.1:${SCHOOL_LOOPBACK_PORT}. There is no bundled
# reverse proxy here and no host Caddyfile to edit, unlike a manual
# compose-only deployment.
