  "version": 2,
  "scope": "Section 6.1 corpus for the streaming chat benchmark (CHATBOT-LATENCY-PLAN): 50 independent questions, 10 per language: English, French, Spanish, Modern Standard Arabic and Moroccan Darija (ary, answered in Arabic script). Each language has the same ten kinds of question: greeting, student count, teacher count (teachers_get_teacher_count since 2026-10-03; before it the model counted a list), class list, today's attendance, upcoming exams, a two-tool question, a lookup that finds nothing, and two writes that must stay blocked. Names in write and missing-record cases are synthetic and must not match real records. The announcement writes need no lookup, so the model reaches the confirmation-marked tool. Answer facts match the seed:demo dataset of 2026-10-02 (100 students, 50 teachers, classes CP to 3AC); recheck them after reseeding.",
  "role": "admin",
  "academicYear": "2026-2027",
  "cases": [
    { "id": "greeting-en", "language": "en", "kind": "small-talk", "query": "Hello! What can you help me with?" },
    { "id": "student-count-en", "language": "en", "kind": "single-read", "query": "How many students are enrolled this year?", "expectedToolGroups": [["students_get_student_count"]], "answerFacts": ["100"] },
    { "id": "teacher-count-en", "language": "en", "kind": "single-read", "query": "How many teachers does the school have?", "expectedToolGroups": [["teachers_get_teacher_count", "teachers_get_teachers", "search_search_teachers", "staff_get_staff_count"]], "answerFacts": ["50"] },
